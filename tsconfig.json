{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "src/*"]
    },
    "types": ["node", "jest", "cypress"]
  },
  "include": ["src/**/*.ts", "cypress/**/*.ts", "jest.config.ts", "cypress.config.ts"],
  "exclude": ["node_modules"]
}
