# Environment Profile: local | dev | qa | staging
TEST_ENV=local
USE_DUMMY_APP=true
DUMMY_APP_PORT=3000
DASHBOARD_PORT=4000

# Optional Overrides (default values come from config/environments/<TEST_ENV>.json)
# BASE_URL=http://localhost:3000
API_TIMEOUT=5000

# OAuth 2.0 Credentials
# OAUTH_TOKEN_URL=http://localhost:3000/oauth/token
OAUTH_CLIENT_ID=demo-client-id
OAUTH_CLIENT_SECRET=demo-client-secret
OAUTH_GRANT_TYPE=client_credentials

# Cypress E2E Overrides
# CYPRESS_BASE_URL=http://localhost:3000
CYPRESS_USERNAME=admin
CYPRESS_PASSWORD=password

# Jenkins CI/CD Integration (leave JENKINS_URL blank or JENKINS_MOCK=true for built-in simulator)
JENKINS_MOCK=true
# JENKINS_URL=https://jenkins.company.internal
# JENKINS_USER=jenkins-bot
# JENKINS_API_TOKEN=your-jenkins-api-token
JENKINS_JOB_NAME=sdet-test-framework
